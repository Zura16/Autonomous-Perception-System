# ── Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/

# ── Environments
venv/
.venv/
env/
ENV/

# ── Datasets (fetched, never committed -- tools/fetch_kitti.py reproduces them)
# Anchored to the repo root on purpose. An unanchored `data/` matches ANY
# directory of that name at any depth, which silently swallowed site/data/ --
# the exported replay the published page depends on. The page deployed, every
# frame 404'd, and the only visible symptom was a spinner that never cleared.
/data/
!/data/.gitkeep

# ── Model weights (downloaded artefacts, not source)
*.pt
*.onnx
*.engine

# ── Generated artefacts
#   Figures in docs/figures/ ARE committed: the charter requires every plot to be
#   a committed artefact regenerated by a committed script from a committed row.
artifacts/
runs/
*.mp4
!legacy/**/*.mp4

# ── OS
.DS_Store
